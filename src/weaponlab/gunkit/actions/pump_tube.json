   "gun": [{"from": 0.1, "to": 0.35, "roll": 30.0, "pitch": 8.0, "move": [0.0, -5.0, 5.0], "ease": "inout"},
           {"from": 1.4, "to": 1.8, "roll": 0.0, "pitch": 0.0, "move": [0.0, 0.0, 0.0], "ease": "inout"}],
   "events": [],
   "expect": [{"at": [0.7, 1.0], "visible": "port"}]},
  "reload": {"seconds": 1.3,
   "gun": [{"from": 0.05, "to": 0.3, "roll": -70.0, "pitch": 5.0, "move": [0.0, -4.0, 2.0], "ease": "inout"},
           {"from": 1.05, "to": 1.3, "roll": -70.0, "pitch": 5.0, "move": [0.0, -4.0, 2.0], "ease": "inout"}],
   "events": [
    {"hand": "l", "from": 0.0, "to": 0.35, "go": {"place": "chest_l"}, "why": "the support hand to the shell carrier on the chest"},
    {"hand": "l", "from": 0.35, "to": 0.45, "go": {"place": "chest_l", "offset": [0.0, 0.0, 2.0]}, "carry": "shell", "why": "one shell"},
    {"hand": "l", "from": 0.45, "to": 0.8, "go": {"mark": "load_port", "offset": [0.0, -3.0, -3.0]}, "why": "the gun rolled on its side, the shell to the port"},
    {"hand": "l", "from": 0.8, "to": 0.95, "go": {"mark": "load_port", "offset": [0.0, 4.0, 0.0]}, "seat": "shell", "grasp": "thumb", "why": "pushed in past the carrier and the shell latch with the thumb"},
    {"hand": "l", "from": 1.0, "to": 1.2, "go": {"mark": "load_port", "offset": [0.0, 0.0, -4.0]}, "why": "the thumb out, ready for the next"}],
   "expect": []},
  "reload_empty": {"seconds": 1.9,
   "gun": [{"from": 0.05, "to": 0.3, "roll": -70.0, "pitch": 5.0, "move": [0.0, -4.0, 2.0], "ease": "inout"},
           {"from": 1.0, "to": 1.25, "roll": 0.0, "pitch": 0.0, "move": [0.0, 0.0, 0.0], "ease": "inout"}],
   "events": [
    {"hand": "l", "from": 0.0, "to": 0.35, "go": {"place": "chest_l"}, "why": "to the shells"},
    {"hand": "l", "from": 0.35, "to": 0.45, "go": {"place": "chest_l", "offset": [0.0, 0.0, 2.0]}, "carry": "shell", "why": "one shell"},
    {"hand": "l", "from": 0.45, "to": 0.8, "go": {"mark": "load_port", "offset": [0.0, -3.0, -3.0]}, "why": "to the port"},
    {"hand": "l", "from": 0.8, "to": 0.95, "go": {"mark": "load_port", "offset": [0.0, 4.0, 0.0]}, "seat": "shell", "grasp": "thumb", "why": "in"},
    {"hand": "l", "from": 1.0, "to": 1.3, "go": {"part": "pump", "mark": "support"}, "why": "back to the slide to work it"}],
   "expect": [{"at": [1.35, 1.75], "on": {"l": "support"}}]}
 }
}
