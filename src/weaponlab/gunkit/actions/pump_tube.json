{
 "contract": "weaponlab-action/1",
 "id": "pump_tube",
 "name": "a pump (slide) action over a tube magazine, loaded a shell at a time through the port underneath (Model 12)",
 "extends": "_long_gun",
 "guns": ["Model 12 trench gun"],
 "manuals": [
  {"title": "a public-domain manual for the Winchester Model 12 trench gun (a US Army handbook of the 1940s)", "covers": "working the slide, loading the magazine tube, the slide release", "status": "to find"}
 ],
 "parts": {
  "pump": {"kind": "slide", "what": "the slide handle (fore-end), drawn back by the support hand", "travel_cm": 9.0},
  "bolt": {"kind": "slide", "what": "the breech bolt, drawn back with the slide", "travel_cm": 9.0},
  "carrier": {"kind": "turn", "what": "the carrier (lifter) raising a shell to the chamber", "required": false},
  "trigger": {"kind": "turn", "what": "the trigger", "required": false},
  "shell": {"kind": "free", "what": "one shell in the hand on its way to the loading port", "required": false}
 },
 "marks": ["grip", "support", "port", "load_port"],
 "sources": [
  "the support hand rides the slide (facts mark_parts support: pump)",
  "a pump stroke takes about a third of a second when worked hard",
  "the game loads one shell per reload clip and plays it again for each (single loading)"
 ],
 "gun_clips": {
