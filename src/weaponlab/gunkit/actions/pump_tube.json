   {"part": "carrier", "from": 0.15, "to": 0.22, "value": 1.0, "ease": "out", "why": "the carrier lifts the next shell"},
   {"part": "pump", "from": 0.25, "to": 0.4, "value": 0.0, "ease": "inout", "why": "driven forward: the shell chambered"},
   {"part": "bolt", "from": 0.25, "to": 0.4, "value": 0.0, "ease": "inout", "why": "home"},
   {"part": "carrier", "from": 0.3, "to": 0.36, "value": 0.0, "ease": "in", "why": "down"}]},
  "charge": {"seconds": 0.55, "beats": [
   {"part": "pump", "from": 0.05, "to": 0.2, "value": 1.0, "ease": "out", "why": "back"},
   {"part": "bolt", "from": 0.05, "to": 0.2, "value": 1.0, "ease": "out", "why": "back"},
   {"part": "carrier", "from": 0.15, "to": 0.22, "value": 1.0, "ease": "out", "why": "up"},
   {"part": "pump", "from": 0.25, "to": 0.4, "value": 0.0, "ease": "inout", "why": "forward"},
   {"part": "bolt", "from": 0.25, "to": 0.4, "value": 0.0, "ease": "inout", "why": "home"},
   {"part": "carrier", "from": 0.3, "to": 0.36, "value": 0.0, "ease": "in", "why": "down"}]},
  "check_chamber": {"seconds": 1.8, "beats": [
   {"part": "pump", "from": 0.35, "to": 0.6, "value": 0.3, "ease": "inout", "why": "the slide eased back a little (the slide release pressed on a cocked gun): the shell's rim shows"},
   {"part": "bolt", "from": 0.35, "to": 0.6, "value": 0.3, "ease": "inout", "why": "the bolt with it"},
   {"part": "pump", "from": 1.1, "to": 1.25, "value": 0.0, "ease": "inout", "why": "closed"},
   {"part": "bolt", "from": 1.1, "to": 1.25, "value": 0.0, "ease": "inout", "why": "home"}]},
  "reload": {"seconds": 1.3, "beats": []},
  "reload_empty": {"seconds": 1.9, "beats": [
   {"part": "pump", "from": 1.35, "to": 1.5, "value": 1.0, "ease": "out", "why": "a stroke to chamber the first shell"},
   {"part": "bolt", "from": 1.35, "to": 1.5, "value": 1.0, "ease": "out", "why": "back"},
   {"part": "pump", "from": 1.55, "to": 1.7, "value": 0.0, "ease": "inout", "why": "forward"},
   {"part": "bolt", "from": 1.55, "to": 1.7, "value": 0.0, "ease": "inout", "why": "home"}]}
 },
 "hand_clips": {
  "cycle": {"seconds": 0.55,
   "gun": [{"from": 0.05, "to": 0.15, "pitch": 1.0, "ease": "out"}, {"from": 0.35, "to": 0.55, "pitch": 0.0, "ease": "inout"}],
