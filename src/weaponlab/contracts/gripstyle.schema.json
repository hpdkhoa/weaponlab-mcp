{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "weaponlab-gripstyle/1",
  "title": "weaponlab-gripstyle/1",
  "description": "How a kind of gun is held: each hand's contact (the mark it holds and the face of the gun it lies on), each finger's pose, the clips where the trigger finger goes to the trigger, and the sources. One skeleton holds every style; the style is the hand setup on it. Faces are gun-space directions (+X the gun's left, +Y the muzzle, +Z up).",
  "type": "object",
  "required": [
    "contract",
    "id",
    "name",
    "families",
    "hands",
    "sources"
  ],
  "properties": {
    "contract": {
      "const": "weaponlab-gripstyle/1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "name": {
      "type": "string"
    },
    "families": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "description": "the action families it is the default for"
    },
    "hands": {
      "type": "object",
      "properties": {
        "r": {
          "$ref": "#/$defs/hand"
        },
        "l": {
          "$ref": "#/$defs/hand"
        }
      },
      "required": [
        "r"
      ],
      "additionalProperties": false
    },
    "trigger_clips": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "the hand clips where the firing hand's trigger finger is on the trigger (off it in every other)"
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "the style's own rules, in words, each a check the hand step makes"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "title",
          "where"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string"
          },
          "where": {
            "type": "string"
          },
          "status": {
            "enum": [
              "read",
              "to read"
            ]
          }
        }
      }
    },
    "stance": {
      "type": "object",
      "required": [
        "view_cm",
        "why"
      ],
      "additionalProperties": false,
      "description": "where the gun sits in front of the eye at the hold: its bolt face at view_cm (cm: right, forward, up from the eye), the bore straight ahead; the hands reach it",
      "properties": {
        "view_cm": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "why": {
          "type": "string",
          "minLength": 8
        }
      }
    },
    "soft_contacts": {
      "type": "array",
      "description": "body parts the style lets press into the gun up to a depth, each with its reason (the web of the hand round a pistol's tang); the hand step reports them apart from the clearance",
      "items": {
        "type": "object",
        "required": [
          "segment",
          "max_cm",
          "why"
        ],
        "additionalProperties": false,
        "properties": {
          "segment": {
            "type": "string"
          },
          "max_cm": {
            "type": "number",
            "minimum": 0,
            "maximum": 1.5
          },
          "why": {
            "type": "string",
            "minLength": 8
          }
        }
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "vec3": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "finger": {
      "type": "object",
      "required": [
        "pose",
        "why"
      ],
      "properties": {
        "pose": {
          "enum": [
            "straight",
            "wrap",
            "rest",
            "to"
          ],
          "description": "straight: held at the curls given; wrap: closed until it meets the gun (or its most curl); rest: left as the hold leaves it; to: the thumb's tip brought to a rest point, every joint within its range"
        },
        "curl": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3,
          "description": "straight: the three joints' curl, degrees (a thumb uses the last two)"
        },
        "max_curl": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3,
          "description": "wrap: the most each joint closes"
        },
        "why": {
          "type": "string",
          "minLength": 8
        },
        "point": {
          "$ref": "#/$defs/vec3",
          "description": "to: the rest point for the tip, gun space cm (the firing thumb on the safety)"
        }
      },
      "additionalProperties": false
    },
    "hand": {
      "type": "object",
      "required": [
        "role",
        "contact",
        "fingers"
      ],
      "properties": {
        "role": {
          "enum": [
            "firing",
            "support"
          ]
        },
        "contact": {
          "type": "object",
          "required": [
            "mark",
            "face",
            "why"
          ],
          "additionalProperties": false,
          "properties": {
            "mark": {
              "type": "string"
            },
            "face": {
              "$ref": "#/$defs/vec3",
              "description": "the way the gun's surface faces where the palm lies"
            },
            "why": {
              "type": "string",
              "minLength": 8
            },
            "fingers_toward": {
              "$ref": "#/$defs/vec3",
              "description": "the way the fingers point from the palm (gun space)"
            },
            "anchors": {
              "type": "object",
              "description": "the hold as technique sets it: named points of the hand (web, knuckle, index_knuckle, pinky_knuckle, wrist, palm) and where each goes on the gun (gun space cm); the hand is fitted to them and the solver refines round them",
              "additionalProperties": {
                "$ref": "#/$defs/vec3"
              }
            }
          }
        },
        "fingers": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "index": {
              "$ref": "#/$defs/finger"
            },
            "middle": {
              "$ref": "#/$defs/finger"
            },
            "ring": {
              "$ref": "#/$defs/finger"
            },
            "pinky": {
              "$ref": "#/$defs/finger"
            },
            "thumb": {
              "$ref": "#/$defs/finger"
            }
          }
        },
        "trigger": {
          "$ref": "#/$defs/finger",
          "description": "the trigger finger in the trigger clips"
        },
        "holds": {
          "type": "object",
          "description": "the hand's working holds, by mark (the slide's rear for a rack, a magazine's base for a reload): the face its palm meets and how its fingers close",
          "additionalProperties": {
            "type": "object",
            "required": [
              "face",
              "fingers",
              "why"
            ],
            "additionalProperties": false,
            "properties": {
              "face": {
                "$ref": "#/$defs/vec3"
              },
              "fingers": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "index": {
                    "$ref": "#/$defs/finger"
                  },
                  "middle": {
                    "$ref": "#/$defs/finger"
                  },
                  "ring": {
                    "$ref": "#/$defs/finger"
                  },
                  "pinky": {
                    "$ref": "#/$defs/finger"
                  },
                  "thumb": {
                    "$ref": "#/$defs/finger"
                  }
                }
              },
              "why": {
                "type": "string",
                "minLength": 8
              },
              "fingers_toward": {
                "$ref": "#/$defs/vec3",
                "description": "the way the fingers point from the palm (gun space), so the hand is not turned at random about the face"
              }
            }
          }
        },
        "thumb_rest": {
          "type": "object",
          "required": [
            "mark",
            "offset",
            "why"
          ],
          "additionalProperties": false,
          "description": "where the thumb's tip rests on the hold: a mark and an offset from it (gun space, cm; out by the thumb's radius and the glove)",
          "properties": {
            "mark": {
              "type": "string"
            },
            "offset": {
              "$ref": "#/$defs/vec3"
            },
            "why": {
              "type": "string",
              "minLength": 8
            }
          }
        },
        "contact_rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contact_rule"
          },
          "description": "what touches what while the hand is on its contact: checked on every frame of that hold, the solver aims at them"
        },
        "wrap": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "region",
            "min"
          ],
          "properties": {
            "region": {
              "$ref": "#/$defs/region"
            },
            "min": {
              "type": "number"
            }
          },
          "description": "a band of the held part the hand must cover, as a share of its surface"
        },
        "closure": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "friction": {
              "type": "number"
            },
            "sides": {
              "type": "array",
              "items": {
                "enum": [
                  "l",
                  "r"
                ]
              }
            }
          },
          "description": "force closure: the touches (of these hands) hold the gun against any slip or twist"
        }
      },
      "additionalProperties": false
    },
    "region": {
      "type": "object",
      "required": [
        "part",
        "facing"
      ],
      "additionalProperties": false,
      "description": "a region of the gun's surface, found on whichever mesh is loaded: the part's polygons facing a way, inside a window",
      "properties": {
        "part": {
          "type": "string",
          "description": "frame (the gun's body) or a part of the gun's facts (slide, magazine ...)"
        },
        "facing": {
          "oneOf": [
            {
              "enum": [
                "left",
                "right",
                "front",
                "back",
                "up",
                "down",
                "support_side",
                "firing_side",
                "any"
              ]
            },
            {
              "$ref": "#/$defs/vec3"
            }
          ],
          "description": "the way the surface faces (gun space; support_side and firing_side follow the character's hand)"
        },
        "facing_tol_deg": {
          "type": "number",
          "description": "how far a polygon's normal may lie off facing (default 60)"
        },
        "window": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "x": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "oneOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "string",
                    "pattern": "^([A-Za-z_]+([+-][0-9.]+)?|frac:[0-9.]+)$"
                  }
                ]
              }
            },
            "y": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "oneOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "string",
                    "pattern": "^([A-Za-z_]+([+-][0-9.]+)?|frac:[0-9.]+)$"
                  }
                ]
              }
            },
            "z": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "oneOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "string",
                    "pattern": "^([A-Za-z_]+([+-][0-9.]+)?|frac:[0-9.]+)$"
                  }
                ]
              }
            }
          },
          "description": "per axis [low, high]: gun cm, a mark's coordinate with an offset (stop+0.5), or a fraction of the part's extent (frac:0.3)"
        }
      }
    },
    "contact_rule": {
      "type": "object",
      "required": [
        "id",
        "patch",
        "region",
        "why"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "patch": {
          "type": "string",
          "description": "the hand's skin: thumb|index|middle|ring|pinky with :pad, :tip, :base, :back or :whole; palm; heel; web"
        },
        "region": {
          "$ref": "#/$defs/region"
        },
        "gap_cm": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          },
          "description": "skin to surface, glove counted, [low, high]"
        },
        "facing_max_deg": {
          "type": "number"
        },
        "need": {
          "enum": [
            "required",
            "optional"
          ]
        },
        "why": {
          "type": "string",
          "minLength": 8
        },
        "min_share": {
          "type": "number",
          "description": "the share of the patch's points that must meet the rule (a pad laid along a surface, not one point touching)"
        }
      }
    }
  }
}
